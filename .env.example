# ====================================================================
# Wish Yours — Environment Configuration
# ====================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Google Gemini AI Integration
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase Database & Auth (Optional for local dev, persistent JSON used if empty)
# Get your credentials at: https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Email Delivery Service (Resend or Brevo)
# Get your Resend API Key at: https://resend.com
# NOTE: Resend's free shared sandbox ONLY allows sender "onboarding@resend.dev".
# Once you verify your custom domain on Resend (https://resend.com/domains), you can set:
# RESEND_FROM_EMAIL=Wish Yours <celebrate@yourdomain.com>
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Wish Yours <onboarding@resend.dev>

# Brevo (Alternative Email Provider)
BREVO_API_KEY=your_brevo_api_key_here

# SMS Delivery (Twilio - Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin Dashboard Protection
ADMIN_SECRET_KEY=admin_wishyours_secret_2026

# WhatsApp Cloud API (Optional - for automated server-side delivery)
# Free manual Click-to-Chat (wa.me) works 100% out-of-the-box without these keys.
# WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
# WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
