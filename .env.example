# ====================================================================
# WishCraft AI — Environment Configuration
# ====================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Google Gemini AI Integration
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase Database & Auth (Optional for local dev, persistent JSON used if empty)
# Get your credentials at: https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Email Delivery Service (Resend or Brevo)
# Get your Resend API Key at: https://resend.com
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=WishCraft <wishes@resend.dev>

# Brevo (Alternative Email Provider)
BREVO_API_KEY=your_brevo_api_key_here

# SMS Delivery (Twilio - Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin Dashboard Protection
ADMIN_SECRET_KEY=admin_wishcraft_secret_2026
